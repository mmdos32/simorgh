# Simorgh live ISO — packages in the live environment.
# The live session IS a Simorgh desktop: it boots into Hyprland and
# starts Calamares (the graphical installer) automatically.
# Chromium / VS Code / the rest of the desktop apps are NOT here — they
# are installed into the target by Calamares (see modules/packages.conf,
# generated from packages/pacman.txt).
# One package per line. Lines starting with # are comments.

base
linux
# archiso initramfs hooks (without these the live ISO cannot find or
# mount its own root filesystem — boot fails at Switch Root)
mkinitcpio-archiso
mkinitcpio-nfs-utils
linux-firmware
# Bootloader (required by mkarchiso profile validation)
syslinux
# grub + efibootmgr: the Calamares bootloader step runs BEFORE the
# packages step, so they must already be in the live image.
grub
efibootmgr
# os-prober + ntfs-3g: let GRUB detect other OSes (e.g. Windows) for
# dual-boot; ntfs-3g is what lets os-prober read Windows partitions.
os-prober
ntfs-3g
memtest86+
memtest86+-efi
edk2-shell
intel-ucode
amd-ucode
archinstall
git
curl
sudo
networkmanager
nano
less
parted
dosfstools
e2fsprogs
# Filesystems the Calamares partition UI offers; their mkfs tools must be
# in the live image or formatting fails.
btrfs-progs
xfsprogs
# unsquashfs: unpackfs cannot unpack airootfs.sfs without it.
squashfs-tools
# rsync: Calamares unpackfs copies the mounted airootfs.sfs with
# `rsync -aHAXSr`; without it the install fails with error 127.
rsync
# setxkbmap is the X11 fallback for the Calamares keyboard page.
# (The layout-preview compiler is not an Arch package, so the preview
# degrades to a logged warning on the Wayland live session, which
# uses the locale1 D-Bus path instead.)
xorg-setxkbmap
# dbus: makes dbus-uuidgen available in the target for the Calamares
# machineid step, instead of relying on a transitive dependency.
dbus
cryptsetup
lvm2
jq
python

# Graphical installer
calamares

# Live desktop (Simorgh's own stack, so the live session looks and
# feels like the installed system)
hyprland
waybar
rofi
kitty
sddm
swaync
hyprpaper
hyprlock
hypridle
hyprpolkitagent
xdg-desktop-portal-hyprland
qt6-wayland
pipewire
wireplumber
# PulseAudio/ALSA compat layers: the live Waybar pulseaudio module and
# pavucontrol are dead without them.
pipewire-pulse
pipewire-alsa
zsh
zsh-autosuggestions
zsh-syntax-highlighting
starship
noto-fonts
noto-fonts-emoji
ttf-jetbrains-mono-nerd
inter-font
libnotify
dconf
wl-clipboard
# hyprland.lua runs `wl-paste --watch cliphist store`.
cliphist
grim
slurp
brightnessctl
playerctl
pavucontrol
network-manager-applet
