[Unit]
Description=Simorgh live session setup (live user + desktop config)
Before=display-manager.service
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/lib/simorgh-live-setup.sh
RemainAfterExit=yes
Restart=on-failure
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
