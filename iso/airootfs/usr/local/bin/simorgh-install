#!/usr/bin/env bash
# simorgh-install — install Simorgh from the live ISO.
#   1. checks we're root, on Arch, with internet
#   2. runs archinstall (guided) with a Simorgh preset for base Arch
#   3. prints the one command that installs the Simorgh desktop
#      after the first boot
# The Simorgh desktop itself is installed after reboot by the bootstrap
# one-liner — the same script existing-Arch users run (see README.md).
# This keeps the installer simple and honest: disk layout, encryption,
# and user creation all go through archinstall's own tested menus.
set -euo pipefail

PRESET="/usr/share/simorgh/archinstall-simorgh.json"

info()  { printf '\033[1;36m==>\033[0m %s\n' "$*"; }
warn()  { printf '\033[1;33m[!]\033[0m %s\n' "$*"; }
error() { printf '\033[1;31m[✗]\033[0m %s\n' "$*" >&2; exit 1; }

[[ $EUID -eq 0 ]] || error "Run as root (the live session logs in as liveuser — run this with sudo)."
[[ -f /etc/arch-release ]] || error "This installer runs from the Simorgh live ISO (Arch Linux)."

# --- Internet ----------------------------------------------------------------
info "Checking internet..."
systemctl start NetworkManager 2>/dev/null || true
# Poll for connectivity instead of a fixed sleep — DHCP can be slow.
ONLINE=0
for _ in $(seq 1 15); do
  if curl -fsSL --max-time 5 https://archlinux.org >/dev/null 2>&1; then
    ONLINE=1
    break
  fi
  sleep 2
done
if [[ $ONLINE -eq 0 ]]; then
  error "No internet. Connect first, then run simorgh-install again:
  WiFi:  run nmtui
  Cable: plug it in and wait a few seconds."
fi
info "Internet OK."

# --- Timezone ----------------------------------------------------------------
read -rp "Timezone [UTC]: " TIMEZONE || TIMEZONE="UTC"
TIMEZONE="${TIMEZONE:-UTC}"
if [[ "$TIMEZONE" == /* || "$TIMEZONE" == *..* || ! -f "/usr/share/zoneinfo/$TIMEZONE" ]]; then
  warn "Unknown timezone '$TIMEZONE' — using UTC."
  TIMEZONE="UTC"
fi

# --- Disk warning ------------------------------------------------------------
echo
echo "archinstall will ask you to pick a disk. EVERYTHING on the disk"
echo "you pick will be ERASED. Back up anything you care about first."
echo "Disk encryption, the user account, and the bootloader are all"
echo "chosen in archinstall's own menus."
echo
read -rp "Type YES to continue: " CONFIRM || CONFIRM=""
[[ "$CONFIRM" == "YES" ]] || error "Aborted."

# --- archinstall -------------------------------------------------------------
if ! command -v archinstall >/dev/null; then
  info "Installing archinstall..."
  pacman -Syu --noconfirm archinstall || error "Could not install archinstall."
fi

if [[ -f "$PRESET" ]]; then
  # Inject the chosen timezone into a copy of the preset (this also
  # validates that the preset is real JSON).
  CONFIG="$(mktemp)"
  trap 'rm -f "${CONFIG:-}"' EXIT
  python3 - "$PRESET" "$CONFIG" "$TIMEZONE" <<'PYEOF' || error "Preset $PRESET is not valid JSON."
import json, sys
src, dst, tz = sys.argv[1:4]
with open(src) as f:
    data = json.load(f)
data["timezone"] = tz
with open(dst, "w") as f:
    json.dump(data, f, indent=2)
PYEOF
  info "Installing base Arch with archinstall (Simorgh preset)..."
  archinstall --config "$CONFIG"
  rm -f "$CONFIG"
else
  warn "Preset $PRESET not found — running archinstall without it."
  archinstall
fi

# --- Done --------------------------------------------------------------------
cat <<'EOF'

   ███████╗██╗███╗   ███╗ ██████╗ ██████╗  ██████╗ ██╗  ██╗
   ██╔════╝██║████╗ ████║██╔═══██╗██╔══██╗██╔════╝ ██║  ██║
   ███████╗██║██╔████╔██║██║   ██║██████╔╝██║  ███╗███████║
   ╚════██║██║██╔████╔██║██║   ██║██╔══██╗██║   ██║██╔══██║
   ███████║██║██║ ╚═╝ ██║╚██████╔╝██║  ██║╚██████╔╝██║  ██║
   ╚══════╝╚═╝╚═╝     ╚═╝ ╚═════╝ ╚═╝  ╚═╝ ╚═════╝ ╚═╝  ╚═╝

   Base system installed.

   1. Remove the USB stick and reboot.
   2. Log in as the user you just created.
   3. Run this one command to install the Simorgh desktop:

        curl -fsSL https://raw.githubusercontent.com/mmdos32/simorgh/main/bootstrap.sh | bash

      It takes a while — it installs the desktop, the apps, and
      the themes, then you reboot into Hyprland.

EOF
read -rp "Reboot now? [Y/n]: " REBOOT || REBOOT="n"
if [[ "${REBOOT:-Y}" =~ ^[Yy]$ ]]; then
  reboot
fi
