#!/usr/bin/env bash
# simorgh-keybinds — the Simorgh shortcuts guide (Omarchy-style cheatsheet).
# Opens a searchable Rofi list of every keybind; Esc closes it.
# Open with SUPER + K, or from simorgh-menu.
set -euo pipefail

list() {
  cat <<'EOF'
SUPER + Return — Kitty terminal
SUPER + D — Rofi app launcher
SUPER + E — Maia file manager
SUPER + B — Chromium browser
SUPER + C — VS Code editor
SUPER + U — Sung music player
SUPER + M — Simorgh menu (apps, gaming, updates)
SUPER + T — Switch theme
SUPER + N — Notifications center
SUPER + SHIFT + N — Do Not Disturb on/off
SUPER + K — This shortcuts guide
SUPER + Q — Close window
SUPER + SHIFT + Q — Exit Hyprland
SUPER + F — Fullscreen
SUPER + V — Toggle floating
SUPER + P — Pseudo-tiling
SUPER + J — Toggle split direction
SUPER + L — Lock screen
SUPER + SHIFT + L — Lock + suspend
SUPER + SHIFT + E — Power menu (lock/logout/suspend/reboot/power off)
SUPER + SHIFT + R — Reload Hyprland config
SUPER + Tab — Next window
SUPER + SHIFT + Tab — Previous window
SUPER + grave (`) — Scratchpad terminal
SUPER + R — Resize mode (arrows to resize, Esc to exit)
SUPER + arrows — Move focus
SUPER + CTRL + arrows — Focus monitor (multi-monitor)
SUPER + SHIFT + arrows — Move window
SUPER + 1..0 — Switch workspace
SUPER + SHIFT + 1..0 — Move window to workspace
SUPER + CTRL + 1..0 — Move window to workspace silently
SUPER + Z — Previous workspace
SUPER + SHIFT + V — Clipboard history
SUPER + ALT + C — Calculator (Rofi)
SUPER + ALT + P — Color picker (copies hex)
SUPER + ALT + R — Toggle screen recording
SUPER + ALT + B — Toggle Waybar
SUPER + . — Emoji picker
Print — Full-screen screenshot
SUPER + SHIFT + S — Region screenshot to file
SUPER + SHIFT + C — Region screenshot to clipboard
Alt + Shift — Switch keyboard layout (us / ir)
XF86AudioRaiseVolume / LowerVolume / Mute — Volume
XF86AudioMicMute — Mute microphone
XF86MonBrightnessUp / Down — Brightness
XF86AudioPlay / Next / Prev — Media playback
SUPER + mouse drag — Move / resize window
SUPER + mouse wheel — Switch workspace
3-finger horizontal swipe — Switch workspace
EOF
}

if command -v rofi >/dev/null; then
  # A rofi that exists but fails (no display, killed) used to abort
  # under `set -e` with no message — say so instead of exiting silently.
  # rofi exit 1 is "user cancelled" (Esc) — the documented way to close
  # the guide — not a failure, so only notify on other non-zero codes.
  # `rc=$?` is the first command of the brace group, so it reads the
  # pipeline status before anything else runs; the trailing `|| true`
  # keeps the group at exit 0 so `set -e` can never abort here.
  list | rofi -dmenu -p "Simorgh keybinds — type to search" -i || { rc=$?; [[ $rc -ne 1 ]] && notify-send "Simorgh" "Could not show the shortcuts guide." 2>/dev/null || true; }
else
  # SUPER+K opens this with no terminal visible, so a bare stdout dump
  # would never be seen — show the list in a kitty window (less to
  # search/scroll) instead. The temp file is removed when less exits.
  if command -v kitty >/dev/null; then
    # The temp file is essential to showing the guide in kitty —
    # fail loudly instead of aborting silently under `set -e`.
    tmp="$(mktemp)" || { echo "simorgh-keybinds: could not create a temp file for the shortcuts guide." >&2; exit 1; }
    list > "$tmp" || { echo "simorgh-keybinds: could not write the shortcuts guide to $tmp." >&2; rm -f "$tmp"; exit 1; }
    kitty -e bash -c 'less "$1"; rm -f "$1"' _ "$tmp" &
    kitty_pid=$!
    # If kitty fails to spawn (e.g. no display), the temp file would
    # leak — its rm only runs inside kitty's bash — so check the spawn
    # and clean up. The "showing the guide" notice goes only after the
    # spawn check: on failure the user used to get that notice followed
    # by the contradictory "could not open a terminal" one.
    # 0.5s, matching simorgh-menu's spawn check: a kitty that dies
    # just after 0.2s used to be reported as shown with nothing
    # appearing. Still a heuristic — it can die later still.
    sleep 0.5
    if ! kill -0 "$kitty_pid" 2>/dev/null; then
      rm -f "$tmp"
      if command -v notify-send >/dev/null; then
        notify-send "Simorgh" "Could not open a terminal to show the shortcuts guide." 2>/dev/null || true
      fi
    else
      if command -v notify-send >/dev/null; then
        notify-send "Simorgh" "rofi is not installed — showing the shortcuts guide in a terminal instead." 2>/dev/null || true
      fi
    fi
  else
    if command -v notify-send >/dev/null; then
      notify-send "Simorgh" "rofi is not installed — cannot show the shortcuts guide." 2>/dev/null || true
    fi
    list
  fi
fi
