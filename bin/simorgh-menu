    "Heroic Games Launcher" \
    "Lutris" \
    "ProtonUp-Qt" \
    "MangoHud" \
    "GameMode" \
    "Install all gaming packages")" || return 0
  case "$choice" in
    "Steam")                     run_in_terminal steam ;;
    "Heroic Games Launcher")     run_in_terminal heroic-games-launcher-bin ;;
    "Lutris")                    run_in_terminal lutris ;;
    "ProtonUp-Qt")               run_in_terminal protonup-qt ;;
    "MangoHud")                  run_in_terminal mangohud ;;
    "GameMode")                  run_in_terminal gamemode ;;
    "Install all gaming packages") run_in_terminal steam heroic-games-launcher-bin lutris protonup-qt mangohud gamemode mesa lib32-mesa vulkan-icd-loader lib32-vulkan-icd-loader vulkan-radeon vulkan-intel ;;
    *) return 0 ;;
  esac
  if [[ "${INSTALL_STARTED:-0}" -eq 1 ]]; then notify "Installing $choice..."; fi
}

filemanager_menu() {
  local choice
  choice="$(rofi_menu "Install File Manager" \
    "Maia (default)" \
    "Dolphin" \
    "Thunar" \
    "Nautilus")" || return 0
  case "$choice" in
    "Maia (default)") install_maia ;;
    "Dolphin")  run_in_terminal dolphin; if [[ "${INSTALL_STARTED:-0}" -eq 1 ]]; then notify "Installing Dolphin..."; fi ;;
    "Thunar")   run_in_terminal thunar; if [[ "${INSTALL_STARTED:-0}" -eq 1 ]]; then notify "Installing Thunar..."; fi ;;
    "Nautilus") run_in_terminal nautilus; if [[ "${INSTALL_STARTED:-0}" -eq 1 ]]; then notify "Installing Nautilus..."; fi ;;
    *) return 0 ;;
  esac
}

