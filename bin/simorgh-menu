main() {
  command -v rofi >/dev/null || { echo "rofi is required for simorgh-menu" >&2; exit 1; }
  # Most menu items install packages with yay, but the installer is
  # allowed to finish without it — catch that here, with an offer to
  # install it, instead of failing on the first install with a bare
  # "yay: command not found".
  if ! command -v yay >/dev/null; then
    notify "yay (AUR helper) is not installed — most installs from this menu need it."
    local yay_choice=""
    yay_choice="$(printf 'Install yay now\nContinue without yay' | rofi -dmenu -p "yay is missing" -i)" || yay_choice=""
    if [[ "$yay_choice" == "Install yay now" ]]; then
      if command -v "$TERMINAL" >/dev/null; then
        # Foreground (no `&`): the menu must not continue until yay is
        # installed. Backgrounding this terminal raced the first
        # install pick — the user could pick a package while makepkg
        # was still running, and run_in_terminal then failed with
        # "yay is not installed". The terminal closes on keypress.
        # `|| true`: a closed/killed terminal must not kill the menu
        # under `set -e` — the check below reports the outcome.
        "$TERMINAL" -e bash -c 'tmp=$(mktemp -d); trap "rm -rf $tmp" EXIT; git clone --depth 1 https://aur.archlinux.org/yay.git "$tmp/yay" && (cd "$tmp/yay" && makepkg -si --noconfirm) && echo "yay installed." || echo "yay install failed."; echo; read -n1 -s -r -p "Press any key to close."' || true
        command -v yay >/dev/null || notify "yay install failed — most installs from this menu need it."
      else
        local tmp
        tmp="$(mktemp -d)" || { notify "Could not create a temporary directory — yay install did not start."; return 0; }
        (git clone --depth 1 https://aur.archlinux.org/yay.git "$tmp/yay" && (cd "$tmp/yay" && makepkg -si --noconfirm)) || notify "yay install failed."
        rm -rf "$tmp"
      fi
    fi
  fi
  local choice
  choice="$(main_menu)" || exit 0
  case "$choice" in
    *"Install Browser")       browser_menu ;;
    *"Install Terminal")      terminal_menu ;;
    *"Install Editor")        editor_menu ;;
    *"Install File Manager")  filemanager_menu ;;
    *"Install Apps")          apps_menu ;;
    *"Dev Tools")             devtools_menu ;;
    *"Gaming")                gaming_menu ;;
    *"Themes")                simorgh-theme ;;
    *"Keybinds")              simorgh-keybinds ;;
    *"Install Flatpak")       install_flatpak ;;
    *"Update Simorgh")
      if command -v "$TERMINAL" >/dev/null; then
        spawn_checked "simorgh-update && echo 'Simorgh updated.' || echo 'Simorgh update failed.'; echo; read -n1 -s -r -p 'Press any key to close.'"
        if [[ "$SPAWN_OK" -eq 1 ]]; then
          notify "Updating Simorgh..."
        else
          notify "Could not open a terminal — Simorgh update did not start."
        fi
      else
        simorgh-update || notify "Simorgh update failed."
      fi ;;
    *"Update System")
      if ! command -v yay >/dev/null; then
        notify "yay is not installed — cannot update the system."
      else
        if command -v "$TERMINAL" >/dev/null; then
          spawn_checked "yay -Syu && echo 'System updated.' || echo 'System update failed.'; echo; read -n1 -s -r -p 'Press any key to close.'"
          if [[ "$SPAWN_OK" -eq 1 ]]; then
            notify "Updating system..."
          else
            notify "Could not open a terminal — system update did not start."
          fi
        else
          yay -Syu || notify "System update failed."
        fi
      fi ;;
    *) exit 0 ;;
  esac
}

main "$@"
