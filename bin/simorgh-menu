  local choice
  choice="$(rofi_menu "Music" \
    "Sung (default)" \
    "Spotify" \
    "SoundCloud (web app)" \
    "Amberol" \
    "Rhythmbox")" || return 0
  case "$choice" in
    "Sung (default)")       install_sung ;;
    "Spotify")              run_in_terminal spotify; if [[ "${INSTALL_STARTED:-0}" -eq 1 ]]; then notify "Installing Spotify..."; fi ;;
    "SoundCloud (web app)") install_soundcloud ;;
    "Amberol")              run_in_terminal amberol; if [[ "${INSTALL_STARTED:-0}" -eq 1 ]]; then notify "Installing Amberol..."; fi ;;
    "Rhythmbox")            run_in_terminal rhythmbox; if [[ "${INSTALL_STARTED:-0}" -eq 1 ]]; then notify "Installing Rhythmbox..."; fi ;;
    *) return 0 ;;
  esac
}

