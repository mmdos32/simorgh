    "Zed")              run_in_terminal zed ;;
    "VSCodium")         run_in_terminal vscodium ;;
    "VS Code (default)") run_in_terminal visual-studio-code-bin ;;
    *) return 0 ;;
  esac
  if [[ "${INSTALL_STARTED:-0}" -eq 1 ]]; then notify "Installing $choice..."; fi
}

