  # gcc/make (via base-devel) and python/nodejs are preinstalled by
  # install.sh — only the packages that are not installed yet are
  # listed here, matching packages/apps.txt.
  pick_and_install "Dev Tools" \
    "C/C++ debugger (gdb)|gdb" \
    "Python package installer (pip)|python-pip" \
    "Node.js package manager (npm)|npm" \
    "Rust (rustup)|rustup" \
    "Go|go" \
    "Docker|docker docker-compose" \
    "lazygit|lazygit" \
    "GitHub CLI|github-cli" \
    "Install all dev tools|gdb python-pip npm rustup go docker docker-compose lazygit github-cli"
}

