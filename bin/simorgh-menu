#!/usr/bin/env bash
# simorgh-menu — the Simorgh app menu (Rofi).
# Install alternative browsers / terminals / editors, gaming tools,
# switch themes, or update the system — all with yay.
set -euo pipefail

TERMINAL="${SIMORGH_TERMINAL:-kitty}"

# spawn_checked <bash -c string> — open a terminal window running the
# command and set SPAWN_OK=1 only if the terminal is still alive a
# moment later. A backgrounded terminal that dies instantly (e.g. no
# display) used to be reported as "Installing ..." with nothing ever
# appearing, so callers only notify when SPAWN_OK=1.
spawn_checked() {
  "$TERMINAL" -e bash -c "$1" &
  local pid=$!
  # 0.5 s, not 0.2 s: a terminal that dies just after 0.2 s (a late
  # startup crash) used to be reported as "Installing ..." with
  # nothing appearing. Still a heuristic — a terminal can die later
  # still — but the wider window covers the common late failures.
  sleep 0.5
  if kill -0 "$pid" 2>/dev/null; then SPAWN_OK=1; else SPAWN_OK=0; fi
}

run_in_terminal() {
  # run_in_terminal <package...> — install in a visible terminal window
  # Sets INSTALL_STARTED=1 when the install actually started, 0 when it
  # bailed early (yay missing) or failed in the foreground: callers only
  # notify "Installing ..." when it started.
  local pkgs=("$@")
  INSTALL_STARTED=0
  if ! command -v yay >/dev/null; then
    notify "yay is not installed — cannot install ${pkgs[*]}. Re-run install.sh or install yay first."
    echo "simorgh-menu: yay is not installed; cannot install: ${pkgs[*]}" >&2
    return 0
  fi
  # Docker needs group + service setup after the package install, or
  # every docker command fails with permission denied.
  local docker_setup=""
  if [[ " ${pkgs[*]} " == *" docker "* ]]; then
    # &&-chained to the yay install: this must only run when yay
    # succeeded, or usermod fails on the not-yet-created docker group.
    # The brace group always exits 0 (its last command is an echo
    # either way), so a docker-setup failure reports itself instead
    # of making the whole chain print "Install failed" for packages
    # that installed fine.
    docker_setup=" && { echo 'Setting up Docker (group + service)...'; sudo usermod -aG docker \"\$USER\" && sudo systemctl enable --now docker && echo 'Docker ready — log out and back in for the group to take effect.' || echo 'Docker setup failed — the packages installed, but the docker group/service setup did not.'; }"
  fi
  if command -v "$TERMINAL" >/dev/null; then
    # The closing prompt reports the real outcome instead of a blanket
    # "Done" on failure (same as the Maia branch below).
    spawn_checked "yay -S --noconfirm --needed ${pkgs[*]}$docker_setup && echo 'Install succeeded.' || echo 'Install failed.'; echo; read -n1 -s -r -p 'Press any key to close.'"
    INSTALL_STARTED="$SPAWN_OK"
    if [[ "$SPAWN_OK" -eq 0 ]]; then
      notify "Could not open a terminal — install of ${pkgs[*]} did not start."
    fi
  else
    if yay -S --noconfirm --needed "${pkgs[@]}"; then
      INSTALL_STARTED=1
      if [[ -n "$docker_setup" ]]; then
        if sudo usermod -aG docker "${USER:-$(id -un)}" && sudo systemctl enable --now docker; then
          notify "Docker ready — log out and back in for the group to take effect."
        else
          notify "Docker setup failed — the packages installed, but the docker group/service setup did not."
        fi
      fi
    else
      notify "Install failed: ${pkgs[*]}"
    fi
  fi
}

notify() {
  command -v notify-send >/dev/null && notify-send "Simorgh" "$*" 2>/dev/null || true
}

rofi_menu() { # rofi_menu <prompt> <options...>
  local prompt="$1"; shift
  printf '%s\n' "$@" | rofi -dmenu -p "$prompt" -i
}

pick_and_install() { # pick_and_install <prompt> <"Label|pkg ..." ...>
  # Generic one-level picker: each item is "Label|package names".
  # A package value of "-" means the item is already installed / a no-op.
  local prompt="$1"; shift
  local labels=() pkgs=() item label pkg
  for item in "$@"; do
    label="${item%%|*}"; pkg="${item##*|}"
    labels+=("$label"); pkgs+=("$pkg")
  done
  local choice
  choice="$(rofi_menu "$prompt" "${labels[@]}")" || return 0
  local i
  for i in "${!labels[@]}"; do
    if [[ "${labels[$i]}" == "$choice" ]]; then
      pkg="${pkgs[$i]}"
      [[ "$pkg" == "-" ]] && return 0
      # shellcheck disable=SC2086
      run_in_terminal $pkg
      if [[ "${INSTALL_STARTED:-0}" -eq 1 ]]; then notify "Installing $choice..."; fi
      return 0
    fi
  done
}

install_maia() {
  # Maia has no AUR package: install the official release binary.
  if command -v maia >/dev/null; then
    notify "Maia is already installed."
    return 0
  fi
  local url="https://github.com/yappologistic/Maia/releases/latest/download/maia-linux-x86_64"
  if command -v "$TERMINAL" >/dev/null; then
    # Temp dir cleaned by the trap; the closing prompt reports the real
    # outcome instead of a blanket "Done" on failure. --set-default is
    # a separate step: it failing must not report the install itself
    # as failed (it only sets the default file manager).
    spawn_checked "tmp=\$(mktemp -d); trap 'rm -rf \"\$tmp\"' EXIT; cd \"\$tmp\" && curl -fsSL -O $url && chmod +x maia-linux-x86_64 && ./maia-linux-x86_64 --install && echo 'Maia installed.' || echo 'Maia install failed.'; maia --set-default 2>/dev/null || true; echo; read -n1 -s -r -p 'Press any key to close.'"
    if [[ "$SPAWN_OK" -eq 1 ]]; then
      notify "Installing Maia..."
    else
      notify "Could not open a terminal — Maia install did not start."
    fi
  else
    local tmp ok=0
    tmp="$(mktemp -d)" || { notify "Could not create a temporary directory — Maia install did not start."; return 0; }
    (cd "$tmp" && curl -fsSL -O "$url" && chmod +x maia-linux-x86_64 && ./maia-linux-x86_64 --install) && ok=1
    rm -rf "$tmp"
    if [[ $ok -eq 1 ]]; then
      maia --set-default 2>/dev/null || true
      notify "Maia installed."
    else
      notify "Maia install failed."
    fi
  fi
}

install_sung() {
  # Sung has no AUR package and no releases: build from source,
  # per-user install into ~/.local (never with sudo).
  if [[ -x "$HOME/.local/bin/sung" ]]; then
    notify "Sung is already installed."
    return 0
  fi
  if command -v "$TERMINAL" >/dev/null; then
    # A failed clone leaves a half-created directory behind, and
    # `git clone` refuses to clone into a non-empty one — every later
    # attempt would fail the same way until it was deleted by hand.
    # Remove it, but only when the clone created it. The install step
    # runs only when the clone/pull just succeeded (sung_ok): a
    # stale/partial checkout — e.g. a failed pull, or a clone that
    # died leaving a .git behind — must not get its install.sh run.
    spawn_checked 'mkdir -p "$HOME/.local/src"; sung_ok=0; if [[ -d "$HOME/.local/src/Sung/.git" ]]; then (cd "$HOME/.local/src/Sung" && git pull --ff-only) && sung_ok=1 || echo "Sung update failed."; else had_sung_dir=0; [[ -e "$HOME/.local/src/Sung" ]] && had_sung_dir=1; git clone https://github.com/yappologistic/Sung.git "$HOME/.local/src/Sung" && sung_ok=1 || { echo "Sung download failed."; [[ $had_sung_dir -eq 0 ]] && rm -rf "$HOME/.local/src/Sung"; }; fi; if [[ $sung_ok -eq 1 ]]; then (cd "$HOME/.local/src/Sung" && ./scripts/install.sh) || echo "Sung install failed."; fi; echo; read -n1 -s -r -p "Press any key to close."'
    if [[ "$SPAWN_OK" -eq 1 ]]; then
      notify "Installing Sung..."
    else
      notify "Could not open a terminal — Sung install did not start."
    fi
  else
    mkdir -p "$HOME/.local/src" || { notify "Could not create ~/.local/src — Sung install did not start."; return 0; }
    # Like the terminal branch above, the install step runs only when
    # the clone/pull just succeeded (sung_ok): a failed pull must not
    # get its install.sh run on the stale checkout.
    local sung_ok=0
    if [[ -d "$HOME/.local/src/Sung/.git" ]]; then
      if (cd "$HOME/.local/src/Sung" && git pull --ff-only); then
        sung_ok=1
      else
        notify "Could not update Sung; keeping the existing checkout."
      fi
    else
      # A failed clone leaves a half-created directory behind, and
      # `git clone` refuses to clone into a non-empty one — every
      # later attempt would fail the same way until it was deleted
      # by hand. Remove it, but only when the clone created it: a
      # directory that was already there may hold the user's files.
      local sung_had_dir=0
      [[ -e "$HOME/.local/src/Sung" ]] && sung_had_dir=1
      git clone https://github.com/yappologistic/Sung.git "$HOME/.local/src/Sung" || {
        notify "Could not download Sung — check your network and try again."
        [[ "$sung_had_dir" -eq 0 ]] && rm -rf "$HOME/.local/src/Sung"
        return 0
      }
      sung_ok=1
    fi
    if [[ "$sung_ok" -eq 1 ]]; then
      if (cd "$HOME/.local/src/Sung" && ./scripts/install.sh); then
        notify "Sung installed."
      else
        notify "Sung install failed."
      fi
    fi
  fi
}

install_soundcloud() {
  # No official SoundCloud Linux app: add it as a Chromium web app.
  # Both writes are essential to the "added" notify below — a failure
  # must say so instead of aborting silently under `set -e`.
  mkdir -p "$HOME/.local/share/applications" || {
    notify "Could not add the SoundCloud web app — could not create ~/.local/share/applications."
    echo "simorgh-menu: could not create ~/.local/share/applications for the SoundCloud web app." >&2
    return 0
  }
  if ! cat > "$HOME/.local/share/applications/soundcloud.desktop" <<'EOF'; then
[Desktop Entry]
Name=SoundCloud
Comment=SoundCloud as a web app (Chromium)
Exec=chromium --app=https://soundcloud.com
Icon=audio-x-generic
Type=Application
Categories=AudioVideo;Audio;
StartupNotify=true
EOF
    notify "Could not add the SoundCloud web app — could not write soundcloud.desktop."
    echo "simorgh-menu: could not write ~/.local/share/applications/soundcloud.desktop." >&2
    return 0
  fi
  notify "SoundCloud web app added."
}

install_flatpak() {
  # Flatpak is NOT preinstalled; this sets it up with Flathub on demand.
  if command -v flatpak >/dev/null && flatpak remotes 2>/dev/null | grep -q flathub; then
    notify "Flatpak + Flathub are already set up."
    return 0
  fi
  if command -v "$TERMINAL" >/dev/null; then
    # The closing prompt reports the real outcome instead of a blanket
    # "Done" on failure (same as the Maia branch above).
    spawn_checked "sudo pacman -S --needed --noconfirm flatpak && flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo && echo 'Flatpak + Flathub installed.' || echo 'Flatpak install failed.'; echo; read -n1 -s -r -p 'Press any key to close.'"
    if [[ "$SPAWN_OK" -eq 1 ]]; then
      notify "Installing Flatpak + Flathub..."
    else
      notify "Could not open a terminal — Flatpak install did not start."
    fi
  else
    if sudo pacman -S --needed --noconfirm flatpak && flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo; then
      notify "Flatpak + Flathub installed."
    else
      notify "Flatpak install failed."
    fi
  fi
}

main_menu() {
  rofi_menu "Simorgh" \
    "󰍹  Install Browser" \
    "󰆍  Install Terminal" \
    "󰨞  Install Editor" \
    "󰉋  Install File Manager" \
    "󰏖  Install Apps" \
    "󰅨  Dev Tools" \
    "󰍳  Gaming" \
    "󰏘  Themes" \
    "󰌌  Keybinds" \
    "󰏖  Install Flatpak" \
    "󰚰  Update Simorgh" \
    "󰚰  Update System"
}

browser_menu() {
  local choice
  choice="$(rofi_menu "Install Browser" \
    "Firefox" \
    "Brave" \
    "Zen Browser" \
    "Chromium (default)")" || return 0
  case "$choice" in
    "Firefox")          run_in_terminal firefox ;;
    "Brave")            run_in_terminal brave-bin ;;
    "Zen Browser")      run_in_terminal zen-browser-bin ;;
    "Chromium (default)") run_in_terminal chromium ;;
    *) return 0 ;;
  esac
  if [[ "${INSTALL_STARTED:-0}" -eq 1 ]]; then notify "Installing $choice..."; fi
}

terminal_menu() {
  local choice
  choice="$(rofi_menu "Install Terminal" \
    "Alacritty" \
    "Ghostty" \
    "Foot" \
    "Kitty (default)")" || return 0
  case "$choice" in
    "Alacritty")        run_in_terminal alacritty ;;
    "Ghostty")          run_in_terminal ghostty ;;
    "Foot")             run_in_terminal foot ;;
    "Kitty (default)")  run_in_terminal kitty ;;
    *) return 0 ;;
  esac
  if [[ "${INSTALL_STARTED:-0}" -eq 1 ]]; then notify "Installing $choice..."; fi
}

